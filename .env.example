# Copy this file to .env and fill with your Supabase project values
# Vite requires env vars exposed to the client to be prefixed with VITE_

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Supabase service_role (DO NOT commit or expose this to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Briams Technologies — Environment Variables Example
# Copy this file, rename to .env, and fill in your values.

# Supabase
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# EmailJS (Contact Form)
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""
